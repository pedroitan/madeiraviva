---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Loja from '../layouts/Loja.astro';
import { TIPOS, STATUS, brl, ordenar, slug, dimensoes } from '../lib/obras';
import { fotoMeta } from '../lib/fotos';
import config from '../data/config.json';

const obras = ordenar(await getCollection('obras'));
const reais = obras.filter((o) => o.data.situacao !== 'embreve');
const disponiveis = reais.filter((o) => o.data.situacao === 'disponivel').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Loja Madeira Viva',
  description:
    'Peças únicas feitas de uma só jaqueira. Cada obra existe em uma unidade e sai com certificado de origem.',
  url: 'https://ateliemadeiraviva.com',
};
---

<Loja
  title="Madeira Viva · Marcenaria & Design"
  description="Peças únicas em jaqueira, numeradas e com certificado de origem. Uma árvore. Poucas peças."
  jsonLd={jsonLd}
>
  <main class="wrap" id="top">
    <section class="hero">
      <div class="hero-bg-text" aria-hidden="true">Viva</div>
      <div class="hero-eyebrow">Marcenaria &amp; Design · Loja</div>
      <h1>Uma árvore.<br /><em>Poucas peças.</em></h1>
      <p class="hero-tagline">{config.hero_tagline}</p>
      <div class="hero-meta">
        <div class="hero-meta-item"><span>Disponíveis</span><span>{disponiveis} de {reais.length} obras</span></div>
        <div class="hero-meta-item"><span>Matéria-Prima</span><span>Jaqueira Nativa</span></div>
        <div class="hero-meta-item"><span>Acabamento</span><span>Resina &amp; Mica</span></div>
      </div>
      <div class="dots" aria-hidden="true">
        {reais.map((o) => (
          <i
            class={o.data.situacao === 'adquirida' ? 'off' : o.data.situacao === 'reservada' ? 'res' : ''}
            title={`Nº ${slug(o)} · ${STATUS[o.data.situacao]}`}
          />
        ))}
      </div>
      <div class="hero-line"></div>
    </section>

    <section class="section">
      <div class="section-label">01 — Catálogo</div>
      <div class="bar">
        <div class="chips" role="group" aria-label="Filtrar por tipo">
          {Object.entries(TIPOS).map(([k, v]) => (
            <button class="pill" data-f={k} aria-pressed={k === 'todas'}>{v}</button>
          ))}
        </div>
        <label class="toggle"><input type="checkbox" id="onlyAvail" /> Só disponíveis</label>
      </div>
      <div class="grid" id="grid" aria-live="polite">
        {obras.map((o) => {
          const foto = fotoMeta(o.data.fotos[0]);
          const n = slug(o);
          const sold = o.data.situacao === 'adquirida';
          return (
            <a
              class:list={['card', { sold }]}
              href={`/obras/${n}`}
              data-n={n}
              data-tipo={o.data.tipo}
              data-situacao={o.data.situacao}
            >
              <div class="frame">
                {foto ? (
                  <Image
                    src={foto}
                    alt={`${o.data.nome} — obra Nº ${n} em jaqueira`}
                    widths={[400, 800]}
                    sizes="(max-width: 760px) 50vw, 280px"
                    loading="lazy"
                  />
                ) : (
                  <canvas data-draw={n}></canvas>
                )}
                <span class="obra">{o.data.situacao === 'embreve' ? 'Em breve' : `Nº ${n}`}</span>
                {(o.data.situacao === 'reservada' || sold) && (
                  <span class:list={['tag', { dark: sold }]}>{STATUS[o.data.situacao]}</span>
                )}
              </div>
              <div class="info">
                <h3>{o.data.nome}</h3>
                <div class="sub">{dimensoes(o)} · {o.data.cor_mica ?? 'Sem resina'}</div>
                <div class="price-val">
                  {sold
                    ? 'Obra adquirida'
                    : o.data.situacao === 'embreve'
                      ? 'Lista de espera'
                      : brl(o.data.investimento)}
                </div>
              </div>
            </a>
          );
        })}
        <p class="empty" id="gridEmpty" hidden>Nenhuma obra disponível neste filtro.</p>
      </div>
    </section>

    <section class="section">
      <div class="dark-block">
        <div class="section-label">02 — Como adquirir</div>
        <h2 class="section-title">Três passos, <em>sem intermediários.</em></h2>
        <div class="steps">
          <div class="step"><div class="step-num">1</div><div class="step-title">Escolha</div><p>Adicione à seleção as obras que quer levar. Cada uma existe em uma única unidade.</p></div>
          <div class="step"><div class="step-num">2</div><div class="step-title">Adquira</div><p>Finalize pelo Mercado Pago (Pix ou cartão) ou reserve pelo WhatsApp e combine com o ateliê.</p></div>
          <div class="step"><div class="step-num">3</div><div class="step-title">Receba</div><p>Entrega e instalação combinadas diretamente com o ateliê. Cada peça segue com certificado de origem.</p></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-label">03 — O ateliê</div>
      <h2 class="section-title">A árvore virou <em>obra.</em></h2>
      <p class="sobre-texto">
        A jaqueira cresceu no terreno da família, em Salvador, por décadas — sombra, fruta, infância.
        Quando precisou ser cortada, a decisão foi eternizá-la em obra. Sem linha de produção, sem
        assistentes: cada peça passa pelas mãos de uma única pessoa, sai numerada e com certificado
        de origem. Quando o estoque dessa árvore acabar, o projeto se encerra.
      </p>
      <a class="pill" href="/sobre">Conhecer o ateliê</a>
    </section>

    <div class="name-display">
      <img class="lockup" src="/logo-madeira-viva.svg" alt="Madeira Viva — Marcenaria & Design" width="260" />
      <div class="name-divider"></div>
      <div class="name-signature">Ateliê em Salvador, Bahia</div>
    </div>
  </main>

  <aside class="panel" id="detail" aria-label="Ficha da obra" aria-hidden="true">
    <div class="phead"><span id="dObra">Obra</span><button class="x" data-close aria-label="Fechar">×</button></div>
    <div class="pbody" id="dBody"></div>
    <div class="pfoot" id="dFoot"></div>
  </aside>

  <script>
    import '../scripts/catalogo';
  </script>
</Loja>
