---
import Loja from '../layouts/Loja.astro';
---

<Loja
  title="Página não encontrada — Madeira Viva"
  description="A página que você procurou não existe. Veja o catálogo de peças únicas da Madeira Viva."
>
  <main class="wrap">
    <section class="hero">
      <div class="hero-eyebrow">Erro 404</div>
      <h1>Esta página <em>não existe.</em></h1>
      <p class="hero-tagline">
        Talvez o link tenha mudado — a loja agora fica na home. O catálogo está logo ali.
      </p>
      <div class="hero-line"></div>
    </section>

    <section class="section">
      <div class="ficha-acoes">
        <a class="pill dark block" href="/">Ver o catálogo</a>
        <a class="pill block" href="/sobre">Conhecer o ateliê</a>
      </div>
    </section>
  </main>
</Loja>
