---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Loja from '../../layouts/Loja.astro';
import { STATUS, brl, slug, dimensoes, acabamento } from '../../lib/obras';
import { fotoMeta, fotoOg } from '../../lib/fotos';
import config from '../../data/config.json';

export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({ params: { numero: slug(obra) }, props: { obra } }));
}

const { obra } = Astro.props;
const { Content } = await render(obra);
const n = slug(obra);
const sit = obra.data.situacao;
const fotos = obra.data.fotos.map((f) => fotoMeta(f)).filter(Boolean);
const waNum = config.whatsapp;
const wa = (msg: string) => `https://wa.me/${waNum}?text=${encodeURIComponent(msg)}`;
const precoFmt = brl(obra.data.investimento);

const availability = {
  disponivel: 'https://schema.org/InStock',
  reservada: 'https://schema.org/SoldOut',
  adquirida: 'https://schema.org/SoldOut',
  embreve: 'https://schema.org/PreOrder',
}[sit];

const ogImage = (await fotoOg(obra.data.fotos[0])) ?? '/logo-madeira-viva.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: `${obra.data.nome} — Obra Nº ${n}`,
      description: obra.body,
      image: new URL(ogImage, Astro.site),
      brand: { '@type': 'Brand', name: 'Madeira Viva' },
      seller: { '@id': 'https://ateliemadeiraviva.com/#atelie' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'BRL',
        ...(obra.data.investimento ? { price: obra.data.investimento } : {}),
        availability,
        url: `https://ateliemadeiraviva.com/obras/${n}`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Catálogo', item: 'https://ateliemadeiraviva.com/' },
        { '@type': 'ListItem', position: 2, name: `Obra Nº ${n}` },
      ],
    },
  ],
};
---

<Loja
  title={`${obra.data.nome} Nº ${n} — peça única de jaqueira | Madeira Viva`}
  description={(obra.body ?? '').slice(0, 160)}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <main class="wrap">
    <a class="crumb" href="/">← Catálogo</a>
    <section class="ficha">
      <div class="galeria" id="galeria" data-n={n}>
        {fotos.length ? (
          fotos.map((f, i) => (
            <button class="frame" data-lb={i} aria-label={`Ampliar foto ${i + 1} de ${obra.data.nome}`}>
              <Image
                src={f!}
                alt={`${obra.data.nome}, foto ${i + 1}`}
                widths={[400, 800, 1600]}
                sizes={i === 0 ? '(max-width: 900px) 100vw, 852px' : '200px'}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </button>
          ))
        ) : (
          <div class="frame"><canvas data-draw={n}></canvas></div>
        )}
      </div>

      <div>
        <h1 class="dt-title" set:html={obra.data.nome.replace(/ (\S+)$/, ' <em>$1</em>')} />
        <div class="dt-price">
          <span>Investimento</span>
          <b>{sit === 'adquirida' ? 'Obra adquirida' : sit === 'embreve' ? 'A definir' : precoFmt}</b>
        </div>
      </div>

      <div class="dt-text"><Content /></div>

      <dl class="specs">
        <dt>Obra</dt><dd>{sit === 'embreve' ? 'A numerar' : `Nº ${n}`}</dd>
        <dt>Madeira</dt><dd>Jaqueira, de uma única árvore</dd>
        <dt>Dimensões</dt><dd>{dimensoes(obra)}</dd>
        <dt>Acabamento</dt><dd>{acabamento(obra)}</dd>
        <dt>Situação</dt><dd>{STATUS[sit]}</dd>
        <dt>Origem</dt><dd>Peça assinada, com certificado de origem</dd>
      </dl>

      <div class="ficha-acoes">
        {sit === 'disponivel' && (
          <>
            <button class="pill dark block" data-addsel data-n={n}>Adicionar à seleção</button>
            <button class="pill block" data-comprar data-n={n}>Adquirir esta obra</button>
            <a
              class="pill block"
              target="_blank"
              rel="noopener"
              href={wa(`Olá! Tenho interesse na obra Nº ${n}, ${obra.data.nome} (${precoFmt}).`)}
              >Falar sobre esta obra</a
            >
          </>
        )}
        {sit === 'reservada' && (
          <a
            class="pill dark block"
            target="_blank"
            rel="noopener"
            href={wa(`Olá! A obra Nº ${n}, ${obra.data.nome}, está reservada. Podem me avisar se ficar disponível?`)}
            >Avisar se ficar disponível</a
          >
        )}
        {sit === 'embreve' && (
          <a
            class="pill dark block"
            target="_blank"
            rel="noopener"
            href={wa(`Olá! Quero entrar na lista de espera do ${obra.data.nome}.`)}
            >Entrar na lista de espera</a
          >
        )}
        {sit === 'adquirida' && (
          <>
            <p class="note">Esta obra já tem dono. Veja as peças ainda disponíveis.</p>
            <a class="pill block" href="/">Voltar ao catálogo</a>
          </>
        )}
      </div>
    </section>
  </main>

  <script>
    import '../../scripts/obra';
  </script>
</Loja>
